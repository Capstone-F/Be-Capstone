NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://admin:admin@localhost:5432/be-capstone

# ── Auth0 ────────────────────────────────────────────
# Tenant domain (no protocol, no trailing slash). Issuer is https://${AUTH0_DOMAIN}/
AUTH0_DOMAIN=dev-xyz.us.auth0.com
AUTH0_CLIENT_ID=REPLACE_ME
AUTH0_CLIENT_SECRET=REPLACE_ME
# Auth0 API identifier. Required so Auth0 issues a real access token for the API.
AUTH0_AUDIENCE=https://api.be-capstone.local
AUTH0_REDIRECT_URI=http://localhost:3000/auth/callback
# Where Auth0 v2/logout sends the browser back. Defaults to FRONTEND_URL when unset.
AUTH0_LOGOUT_RETURN_URL=http://localhost:5173

# ── Sessions / Redis ─────────────────────────────────
REDIS_URL=redis://redis:6379
SESSION_SECRET=change-me-to-a-random-secret
# Omit or true in prod behind HTTPS. Use false if users hit http:// (else no Set-Cookie).
# SESSION_COOKIE_SECURE=false

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
