NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://admin:admin@postgres:5432/be-capstone

KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
# When KC_HTTP_RELATIVE_PATH=/auth, health is under /auth on the management port (9000)
KEYCLOAK_HEALTH_URL=http://keycloak:9000/auth/health/ready
KEYCLOAK_REALM=be-capstone
KEYCLOAK_CLIENT_ID=be-capstone-api
KEYCLOAK_CLIENT_SECRET=be-capstone-secret
KEYCLOAK_REDIRECT_URI=http://localhost:3001/auth/callback
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DEV_ADMIN_USER=glowscan-admin
KEYCLOAK_DEV_ADMIN_PASSWORD=admin

REDIS_URL=redis://redis:6379
SESSION_SECRET=change-me-to-a-random-secret
# Omit or true in prod behind HTTPS. Use false if users hit http:// (else no Set-Cookie).
SESSION_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# VNPay (see docs/payments.md)
VNP_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNP_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
# VNPay gateway host (library appends the endpoint path). Sandbox default below.
VNP_URL=https://sandbox.vnpayment.vn
# Backend endpoint VNPay redirects the browser to (sent as vnp_ReturnUrl). Include /api in prod.
VNP_RETURN_URL=http://localhost:3001/payments/vnpay/return
# IPN URL registered in the VNPay merchant portal (server-to-server). Informational only.
VNP_IPN_URL=http://localhost:3001/payments/vnpay/ipn

# PayOS (see docs/payments.md)
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY
# Backend endpoints PayOS redirects to. Include /api in prod.
PAYOS_RETURN_URL=http://localhost:3001/payments/payos/return
PAYOS_CANCEL_URL=http://localhost:3001/payments/payos/return
# Webhook URL registered in the PayOS merchant portal. Informational only.
PAYOS_WEBHOOK_URL=http://localhost:3001/payments/payos/webhook

# Client landing URLs shared by all gateways (return endpoints 302 here after verifying).
CLIENT_RETURN_URL=http://localhost:3001/vnpay_return
MOBILE_RETURN_URL=glowscan://vnpay-return
# Active payment gateway for order checkout (vnpay | mock | payos). Client APIs unchanged.
PAYMENT_PROVIDER=mock

# Mobile (Expo) deep-link auth — comma-separated whitelist of redirect URIs
MOBILE_REDIRECT_URIS=glowscan://auth/callback
# One-time code TTL after Keycloak callback (seconds)
MOBILE_AUTH_CODE_TTL_SECONDS=120
# OAuth state TTL for mobile login (seconds)
MOBILE_OAUTH_STATE_TTL_SECONDS=600

# LLM provider for routine generation and face-scan (mock | ollama | openai | gemini).
# mock, ollama, and gemini are implemented. Keep mock for tests.
LLM_PROVIDER=mock
# Ollama API (used when LLM_PROVIDER=ollama).
# Default targets host Ollama from a Dockerized API (Windows/Mac Docker Desktop).
# Use http://localhost:11434 only if the Nest API also runs on the host (not in Docker).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_VISION_MODEL=mistral-large-3:675b-cloud
# Shared timeout for Ollama and Gemini chat requests (ms).
OLLAMA_TIMEOUT_MS=120000
# Google AI Studio (used when LLM_PROVIDER=gemini).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash-lite

# GHN shipping (see docs/shipping.md)
# Parcel/business defaults (box size, service type, required_note) are code constants
# in src/delivery/ghn.constants.ts — only credentials and the warehouse live here.
GHN_TOKEN=YOUR_GHN_API_TOKEN
GHN_SHOP_ID=YOUR_GHN_SHOP_ID
# Sandbox default below; production is https://online-gateway.ghn.vn
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
# Warehouse pickup location registered on the GHN shop (from the master-data endpoints).
GHN_FROM_DISTRICT_ID=1442
GHN_FROM_WARD_CODE=21012
# Secret path segment for the webhook URL — GHN does not sign its callbacks.
GHN_WEBHOOK_SECRET=YOUR_LONG_RANDOM_SECRET

# ZegoCloud Video Call (Admin Console → Project → AppID / ServerSecret)
ZEGO_APP_ID=YOUR_ZEGO_APP_ID
ZEGO_SERVER_SECRET=YOUR_32_BYTE_ZEGO_SERVER_SECRET

# Cloudflare R2 (S3-compatible) — image uploads (see docs/uploads.md)
# Leave empty locally if you only PATCH URL fields with placeholders.
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_R2_BUCKET
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Order cancellation pipeline (refund to wallet + staff restock).
# Set CRON_ENABLED=false to drive stages only via POST /admin/order-cancellations/:id/advance.
ORDER_CANCELLATION_CRON_ENABLED=true
ORDER_CANCELLATION_TICK_CRON=*/15 * * * * *
ORDER_CANCELLATION_STEP_DELAY_SEC=60
ORDER_CANCELLATION_BATCH_SIZE=20

# Delivery status simulator (sandbox only — GHN sandbox does not fire webhooks).
# Keep ENABLED=false in production. Local/demo: set true, or drive via POST /admin/deliveries/:id/advance.
DELIVERY_SIMULATION_ENABLED=true
DELIVERY_SIMULATION_TICK_CRON=*/15 * * * * *
DELIVERY_SIMULATION_STEP_DELAY_SEC=60
DELIVERY_SIMULATION_BATCH_SIZE=20
