POSTGRES_DB=be-capstone
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME

PUBLIC_URL=http://localhost
KEYCLOAK_REALM=be-capstone
KEYCLOAK_CLIENT_ID=be-capstone-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_COOKIE_SECURE=false

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME

# ── Public URL (the nginx ingress entrypoint) ────────
# Change to your actual domain in real production (e.g. https://api.example.com)
PUBLIC_URL=http://localhost

# ── Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Session ───────────────────────────────────────────
SESSION_SECRET=replace-with-a-strong-random-secret
# false for http://PUBLIC_URL; set true when users only use https://
SESSION_COOKIE_SECURE=false

# ── Postgres (exposed on host for DB clients) ────────
POSTGRES_DB=be-capstone
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# ── Keycloak ──────────────────────────────────────────
KEYCLOAK_REALM=be-capstone
KEYCLOAK_CLIENT_ID=be-capstone-api
KEYCLOAK_CLIENT_SECRET=be-capstone-secret
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# ── Grafana ───────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
