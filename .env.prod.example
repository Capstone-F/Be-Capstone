# ── Public URL (the nginx ingress entrypoint) ────────
# Change to your actual domain in real production (e.g. https://api.example.com)
PUBLIC_URL=http://localhost

# ── Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Session ───────────────────────────────────────────
SESSION_SECRET=replace-with-a-strong-random-secret
# false for http://PUBLIC_URL; set true when users only use https://
SESSION_COOKIE_SECURE=false

# ── Postgres (exposed on host for DB clients) ────────
POSTGRES_DB=be-capstone
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# ── Auth0 ─────────────────────────────────────────────
# Tenant domain (no protocol, no trailing slash). Issuer is https://${AUTH0_DOMAIN}/
AUTH0_DOMAIN=dev-xyz.us.auth0.com
AUTH0_CLIENT_ID=CHANGE_ME
AUTH0_CLIENT_SECRET=CHANGE_ME
# Auth0 API identifier. Required so Auth0 issues a real access token for the API.
AUTH0_AUDIENCE=https://api.be-capstone.local

# ── Grafana ───────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
