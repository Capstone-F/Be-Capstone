# ── Public URL (the nginx ingress entrypoint) ────────
# Change to your actual domain in real production (e.g. https://api.example.com)
NODE_ENV=production
PORT=3000
PUBLIC_URL=http://localhost
DATABASE_URL=postgresql://admin:admin@postgres:5432/be-capstone

# ── Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Session ───────────────────────────────────────────
SESSION_SECRET=replace-with-a-strong-random-secret
SESSION_COOKIE_SECURE=false

# ── Postgres (exposed on host for DB clients) ────────
POSTGRES_DB=be-capstone
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# ── Keycloak from API ──────────────────────────────────────────
KEYCLOAK_PUBLIC_URL=http://localhost/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
KEYCLOAK_HEALTH_URL=http://keycloak:9000/auth/health/ready
KEYCLOAK_REALM=be-capstone
KEYCLOAK_CLIENT_ID=be-capstone-api
KEYCLOAK_CLIENT_SECRET=be-capstone-secret
KEYCLOAK_REDIRECT_URI=http://localhost/api/auth/callback

# ── Keycloak Bootstrap ──────────────────────────────────────────
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_DB_URL_DATABASE=be-capstone
KC_DB_USERNAME=admin
KC_DB_PASSWORD=admin
KC_HEALTH_ENABLED='true'
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_LOG_CONSOLE_OUTPUT=json
KC_HTTP_RELATIVE_PATH=/auth
KC_PROXY_HEADERS=xforwarded

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Grafana ───────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_ROOT_URL=http://localhost/gfn/
GF_SERVER_SERVE_FROM_SUB_PATH='true'